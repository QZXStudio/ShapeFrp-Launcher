<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>

    <Version Condition="'$(Version)' == ''">$([System.DateTime]::Now.ToString(yy.M.d))</Version>
    <MsiPath>$(MSBuildThisFileDirectory)../QZXFrp.Setup/bin/$(Configuration)/QZXFrp.Setup.msi</MsiPath>

    <DefineConstants>
      Version=$(Version);
      MsiPath=$(MsiPath);
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
