<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- en-US 为基语言，zh-CN 内嵌为 .mst transform，Windows Installer 按系统区域自动选择 -->
    <Culture>en-US;zh-CN</Culture>
    <Version Condition="'$(Version)' == ''">$([System.DateTime]::Now.ToString(yy.M.d))</Version>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)../publish/win-x64/</PublishRoot>
    <!-- ProductCode 由 build.ps1 传入；直接编译时用随机 GUID 兜底 -->
    <ProductCode Condition="'$(ProductCode)' == ''">$([System.Guid]::NewGuid().ToString())</ProductCode>
    <DefineConstants>Version=$(Version);PublishRoot=$(PublishRoot);ProductCode=$(ProductCode)</DefineConstants>
  </PropertyGroup>

  <!-- 构建前先 publish 主项目 -->
  <Target Name="PublishMainApp" BeforeTargets="HarvestDirectory">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\ShapeFrpLauncher\ShapeFrpLauncher.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(PublishRoot)&quot; -p:Version=$(Version)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
