<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
             xmlns:m="clr-namespace:AvaloniaApplication1.Models"
             mc:Ignorable="d"
             x:Class="AvaloniaApplication1.Views.FrpCore.ReleaseListView"
             x:DataType="vm:ReleaseListViewModel">

    <UserControl.Styles>
        <!-- Expander 作为卡片容器 -->
        <Style Selector="Expander.release-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- 隐藏内置箭头（Expander 模板中的 Path 即 chevron 图标） -->
        <Style Selector="Expander.release-card /template/ Path">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- 自定义箭头旋转 -->
        <Style Selector="Expander.release-card ui|SymbolIcon.chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="Expander.release-card:expanded ui|SymbolIcon.chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!-- ItemsControl 子项拉伸 -->
        <Style Selector="ItemsControl.release-list ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- 推荐标签（浅橙色小卡片） -->
        <Style Selector="Border.recommended-badge">
            <Setter Property="Background" Value="#FFF0CC" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,8,24,32" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 加载指示器 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsLoading}">
                <ui:ProgressRing IsActive="True" />
            </StackPanel>

            <!-- 加载失败 -->
            <ui:InfoBar Grid.Row="1"
                        Margin="0,0,0,12"
                        IsOpen="{Binding HasError}"
                        Severity="Error"
                        Title="加载失败"
                        Message="{Binding ErrorMessage}" />

            <!-- 空数据 -->
            <TextBlock Grid.Row="2"
                       Text="暂无 Release"
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />

            <!-- Release 卡片列表 -->
            <ItemsControl Grid.Row="3"
                          Classes="release-list"
                          ItemsSource="{Binding Releases}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ReleaseItem">
                        <Expander Classes="release-card"
                                  Loaded="OnCardLoaded"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto"
									  >
                                    <!-- 左侧：版本信息 -->
                                    <StackPanel Spacing="9"
												Margin="8,4"
												>
                                        <TextBlock Text="{Binding TagName}"
												   Padding="1, 10, 1, 0"
                                                   FontSize="16" FontWeight="SemiBold" 
												   />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <StackPanel Orientation="Horizontal"
														
														Spacing="4">
                                                <ui:SymbolIcon Symbol="Clock"
															   Margin="1, 0, 1, 10"
                                                               FontSize="12"
                                                               Foreground="Gray" />
                                                <TextBlock Text="{Binding DisplayDate}"
														   Padding="1, 0, 1, 10"
                                                           FontSize="12" Foreground="Gray" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}"
													   Padding="1, 0, 1, 10"
                                                       FontSize="12" Foreground="Gray"
                                                       MaxWidth="300"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <!-- 展开内容 -->
                            <StackPanel Spacing="12" Margin="16,0,16,16">
                                <Border Height="1"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                                <!-- 版本说明 -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="版本说明"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="Gray" />
                                    <ScrollViewer MaxHeight="280"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding Body}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   LineHeight="20" />
                                    </ScrollViewer>
                                </StackPanel>

                                <Border Height="1"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                                <!-- 文件信息：全部架构/平台 -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="文件信息"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="Gray" />
                                    <ItemsControl ItemsSource="{Binding Assets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:ReleaseAssetInfo">
												<Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16,12">

													<Grid ColumnDefinitions="Auto,Auto,Auto,*"
														  ColumnSpacing="6"
														  Margin="0,0,0,4">
														<!-- 平台名称 -->
														<TextBlock Text="{Binding Platform}"
																   FontSize="13" FontWeight="SemiBold"
																   VerticalAlignment="Center" />

														<!-- 架构名称 -->
														<TextBlock Grid.Column="1"
																   Text="{Binding Architecture}"
																   FontSize="13" Foreground="Gray"
																   VerticalAlignment="Center" />

														<!-- 推荐标签 -->
														<Border Grid.Column="2"
																Classes="recommended-badge"
																IsVisible="{Binding IsRecommended}"
																VerticalAlignment="Center">
															<TextBlock Text="推荐"
																	   FontSize="11"
																	   Foreground="#CC7700" />
														</Border>

														<!-- 文件大小 - 靠右 -->
														<TextBlock Grid.Column="3"
																   Text="{Binding DisplaySize}"
																   FontSize="12" Foreground="Gray"
																   VerticalAlignment="Center"
																   HorizontalAlignment="Right" />
													</Grid>
												</Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 下载按钮 -->
                                <Button HorizontalAlignment="Right"
                                        FontSize="12"
                                        Padding="28,13,28,13"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M13,4 L13,12 L16,9 L17.5,10.5 L12,16 L6.5,10.5 L8,9 L11,12 L11,4 Z M4,18 L4,20 L20,20 L20,18 Z" />
                                        <TextBlock Text="下载此版本" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 已加载全部 -->
            <TextBlock Grid.Row="4"
                       Text="已加载全部版本"
                       FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       IsVisible="{Binding ShowEndLabel}" />
        </Grid>
    </ScrollViewer>
</UserControl>
