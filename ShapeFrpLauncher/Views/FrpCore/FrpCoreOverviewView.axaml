<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="AvaloniaApplication1.Views.FrpCore.FrpCoreOverviewView">

    <ScrollViewer>
        <StackPanel Margin="16,0,32,32" Spacing="4">
            <ui:SettingsExpander Header="下载Frpc核心"
                                 Description="从远程仓库获取Frpc的Release信息"
                                 IsClickEnabled="True"
                                 ActionIconSource="ChevronRight"
                                 Click="DownloadFrpc_Click">
                <ui:SettingsExpander.IconSource>
                    <ui:SymbolIconSource Symbol="OpenLocal" />
                </ui:SettingsExpander.IconSource>
            </ui:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
