<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="AvaloniaApplication1.Views.CreateTunnelView">

    <UserControl.Styles>
        <Style Selector="ui|TabViewItem:selected /template/ Border#SelectionIndicator">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="ui|TabViewItem:selected /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="32,24,32,12">
            <StackPanel Spacing="2">
                <TextBlock Text="创建隧道" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="配置并启动一个新的 FRP 隧道"
                           FontSize="13" Foreground="Gray" />
            </StackPanel>
        </Border>

        <ui:TabView Grid.Row="1" x:Name="ModeTabView"
                    TabWidthMode="SizeToContent"
                    IsAddTabButtonVisible="False"
                    SelectedIndex="0"
                    Margin="12,0,12,0">

            <ui:TabViewItem Header="ShapeFrp" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Margin="0,8,20,32" Spacing="4">
                        <ui:SettingsExpander Header="ShapeFrp — 隧道类型" Description="需登录 · 请先在左下角登录 ShapeFrp 账号">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Add" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                       
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

            <ui:TabViewItem Header="本地" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Margin="0,8,20,32" Spacing="4">
                        <ui:SettingsExpander Header="隧道类型" Description="选择要创建的隧道协议类型"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Add" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="基本配置" Description="隧道名称、本地地址、本地端口"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Setting" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="远程配置" Description="远程服务器地址、远程端口"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Cloud" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="传输协议" Description="TCP / UDP / HTTP / HTTPS / STCP"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Share" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="加密与压缩" Description="TLS 加密、数据压缩选项"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Permissions" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="健康检查" Description="心跳检测间隔、超时设置"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Like" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="负载均衡" Description="连接池大小、权重配置"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Switch" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                        <ui:SettingsExpander Header="高级选项" Description="自定义头部、子域名绑定"
                                             IsClickEnabled="True" ActionIconSource="ChevronRight">
                            <ui:SettingsExpander.IconSource>
                                <ui:SymbolIconSource Symbol="Code" />
                            </ui:SettingsExpander.IconSource>
                        </ui:SettingsExpander>
                    </StackPanel>
                </ScrollViewer>
            </ui:TabViewItem>

        </ui:TabView>
    </Grid>
</UserControl>
