<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="AvaloniaApplication1.Views.FrpCoreView">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="32,24,32,12">
            <StackPanel Spacing="2">
                <TextBlock Text="FRP 核心" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="管理和创建 Frpc 版本"
                           FontSize="13" Foreground="Gray" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,0,32,32" Spacing="4">
                <ui:SettingsExpander Header="已安装版本" Description="暂无">
                    <ui:SettingsExpander.IconSource>
                        <ui:SymbolIconSource Symbol="OpenLocal" />
                    </ui:SettingsExpander.IconSource>
                </ui:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
