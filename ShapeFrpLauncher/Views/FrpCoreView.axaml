<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="AvaloniaApplication1.Views.FrpCoreView">

    <UserControl.Styles>
        <Style Selector="ui|BreadcrumbBarItem TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="32,24,32,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <ui:BreadcrumbBar x:Name="Breadcrumb" />
                    <TextBlock x:Name="PageDescription"
                               Text="管理和创建 Frpc 版本"
                               FontSize="13" Foreground="Gray" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Width="32" Height="32"
                        Padding="0"
                        CornerRadius="16"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        Click="OnRefreshClick">
                    <ui:SymbolIcon Symbol="Refresh" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <ui:Frame Grid.Row="1" x:Name="ContentFrame" />
    </Grid>
</UserControl>
